# Copie para .env e preencha. NUNCA faça commit do .env de verdade.

# Credenciais da Binance Futures (necessário para provider "binance_futures").
# Se exchange.testnet=true no config.yaml, gere estas chaves em
# https://testnet.binancefuture.com (conta separada da sua conta real).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Credenciais da conta MetaTrader5 (necessário só para provider "mt5", que só funciona no Windows)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Trava de segurança: só operar com dinheiro real se esta variável estiver
# definida EXATAMENTE assim, de forma consciente.
LIVE_TRADING_ACK=
